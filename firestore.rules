rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /shops/{shopId} {
      // Allow reading shop if user is authenticated and is owner or an invited staff collaborator
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.ownerEmail == request.auth.token.email ||
        request.auth.token.email in resource.data.collaborators
      );

      // Any authenticated user can create their own shop
      allow create: if request.auth != null;

      // Only the shop owner can update shop settings or delete the shop
      allow update, delete: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.ownerEmail == request.auth.token.email
      );

      // Product subcollection permissions
      match /products/{productId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid ||
          get(/databases/$(database)/documents/shops/$(shopId)).data.ownerEmail == request.auth.token.email ||
          request.auth.token.email in get(/databases/$(database)/documents/shops/$(shopId)).data.collaborators
        );
      }
    }
  }
}
